{
  "name": "@c9up/ream-mcp",
  "version": "0.1.21",
  "description": "Ream MCP server — agent-ready framework assistant (docs, introspection, actions, BMAD).",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./napi": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./util/project-root": {
      "types": "./src/util/project-root.ts",
      "import": "./src/util/project-root.ts"
    }
  },
  "bin": {
    "ream-mcp": "dist/index.js",
    "ream-mcp-reindex": "dist/cli/reindex.js"
  },
  "files": [
    "dist",
    "index.*.node",
    "index.d.ts",
    "index.js",
    "scripts",
    "src"
  ],
  "scripts": {
    "build:rust": "cargo build --release -p ream-mcp-napi",
    "build:napi": "pnpm build:rust && pnpm build:napi-types && node scripts/copy-napi.mjs",
    "build:napi-types": "node scripts/build-napi-types.mjs",
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "pnpm build:napi && pnpm build:ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "REAM_MCP_DISABLE_EMBEDDINGS=1 cargo test -p ream-mcp-core",
    "lint": "biome check src/ tests/",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build:ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./napi": {
        "types": "./index.d.ts",
        "import": "./index.js"
      },
      "./util/project-root": {
        "types": "./dist/util/project-root.d.ts",
        "import": "./dist/util/project-root.js"
      }
    },
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ts-morph": "^28.0.0"
  },
  "peerDependencies": {
    "@c9up/atlas": "*"
  },
  "peerDependenciesMeta": {
    "@c9up/atlas": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@c9up/atlas": "^0.3.3",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C9up/ream-mcp.git"
  }
}
